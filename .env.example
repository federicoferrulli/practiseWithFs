# AntiGravity File Organizer - Configurazione
# Rinomina questo file in '.env' ed inserisci le tue credenziali OpenRouter

# Chiave API di OpenRouter (necessaria per utilizzare il flag --ai)
OPENROUTER_API_KEY=inserisci_la_tua_api_key_qui

# Opzionale: Sovrascrivi il modello AI predefinito (default: google/gemini-2.5-flash)
# OPENROUTER_MODEL=google/gemini-2.5-flash
